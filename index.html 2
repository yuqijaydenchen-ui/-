<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>🐅 THANK YOU MR. BELLE 🐅</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>
  *{box-sizing:border-box}
  html,body{height:100%;margin:0;padding:0;overflow:hidden;background:#000}
  body{
    font-family:"Comic Sans MS","Comic Sans","Chalkboard SE",cursive;
    cursor:crosshair;-webkit-user-select:none;user-select:none;
    -webkit-tap-highlight-color:transparent;
  }

  /* ================= WORLD (红金中式土味) ================= */
  #world{position:fixed;inset:0;z-index:1}
  #shakebox{position:absolute;inset:0;will-change:transform}
  #scene{position:absolute;inset:-12%;animation:wobble 9s ease-in-out infinite alternate}
  @keyframes wobble{from{transform:rotate(-1.6deg) scale(1.02)}to{transform:rotate(1.6deg) scale(1.1)}}

  #bg{
    position:absolute;inset:0;
    background:
      radial-gradient(circle at 50% 38%, #ff3b3b 0%, #c40000 46%, #6e0000 100%);
    animation:hue 6s linear infinite;
  }
  @keyframes hue{to{filter:saturate(1.5) hue-rotate(360deg)}}

  #rays{
    position:absolute;inset:-60%;pointer-events:none;
    background:repeating-conic-gradient(from 0deg,
      rgba(255,215,0,.9) 0deg 2deg,
      rgba(255,215,0,0) 2deg 7deg);
    animation:spin 16s linear infinite;
    mix-blend-mode:overlay;opacity:.95;
  }
  @keyframes spin{to{transform:rotate(360deg)}}

  #stripes{
    position:absolute;inset:-50%;pointer-events:none;
    background:repeating-linear-gradient(115deg,
      rgba(120,0,0,.6) 0 26px,
      rgba(255,215,0,0) 26px 92px);
    mix-blend-mode:multiply;opacity:.75;
    animation:stripeSlide 3s linear infinite;
  }
  @keyframes stripeSlide{to{transform:translateX(180px)}}

  #wm{
    position:absolute;inset:-20%;z-index:3;pointer-events:none;
    font-family:Impact,"Arial Black",sans-serif;
    font-size:clamp(30px,6vw,84px);line-height:1.12;letter-spacing:.08em;word-spacing:.3em;
    color:rgba(255,215,0,.9);
    -webkit-text-stroke:2px #7a0000;
    transform:rotate(-22deg);opacity:.16;overflow:hidden;
    animation:wmDrift 24s linear infinite alternate;
  }
  @keyframes wmDrift{from{transform:rotate(-22deg) translate(0,0)}to{transform:rotate(-22deg) translate(-90px,-40px)}}

  #tigerwrap{
    position:absolute;left:50%;top:50%;z-index:4;
    width:min(96vh,104vw);aspect-ratio:1;
    transform:translate(-50%,-50%);pointer-events:none;
  }
  #tigerwrap svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
  .spikes{animation:spin 9s linear infinite;opacity:.9;mix-blend-mode:screen}
  .spikes.s2{animation:spin 6s linear infinite reverse;opacity:.65}
  .head{
    filter:drop-shadow(0 0 22px #ff8c00) drop-shadow(0 0 60px #ff0040);
    animation:headPulse 1.5s ease-in-out infinite alternate;
  }
  @keyframes headPulse{from{transform:scale(.95) rotate(-2deg)}to{transform:scale(1.06) rotate(2deg)}}

  .diag{
    position:absolute;left:-30%;width:160%;z-index:6;overflow:hidden;white-space:nowrap;
    background:rgba(70,0,0,.85);
    border-top:3px solid #ffd700;border-bottom:3px solid #ffd700;
    padding:4px 0;
    font-family:Impact,"Arial Black",sans-serif;
    font-size:clamp(.8rem,2.3vw,1.45rem);
    color:#ffd700;text-shadow:0 0 14px #ffd700;
    box-shadow:0 0 30px rgba(0,0,0,.7);
  }
  .diag.m1{top:24%;transform:rotate(-7deg)}
  .diag.m2{bottom:22%;transform:rotate(6deg);color:#ff8c00;text-shadow:0 0 14px #ff8c00}
  .track{display:flex;width:max-content}
  .track span{padding-right:2.5rem}
  .track.c{animation:scroll 9s linear infinite}
  .track.d{animation:scroll 11s linear infinite reverse}
  @keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}

  /* ================= HERO ================= */
  #hero{
    position:absolute;inset:0;z-index:10;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    gap:.1rem;text-align:center;padding:3rem 1rem;
  }
  #hero::before{
    content:"";position:absolute;left:50%;top:50%;width:150%;height:150%;
    transform:translate(-50%,-50%);
    background:radial-gradient(ellipse at center,rgba(0,0,0,.66) 0%,rgba(0,0,0,.4) 42%,rgba(0,0,0,0) 72%);
    pointer-events:none;z-index:-1;
  }
  #hero.shake{animation:shake .42s cubic-bezier(.36,.07,.19,.97) both}
  @keyframes shake{
    10%,90%{transform:translate(-3px,2px) rotate(-.6deg)}
    20%,80%{transform:translate(6px,-4px) rotate(.9deg)}
    30%,50%,70%{transform:translate(-9px,3px) rotate(-1.2deg)}
    40%,60%{transform:translate(9px,-3px) rotate(1.2deg)}
  }

  .kicker{
    font-family:"STKaiti","KaiTi","FangSong","SimSun",serif;
    font-size:clamp(.75rem,2.2vw,1.4rem);letter-spacing:.36em;color:#ffd700;
    text-shadow:2px 2px 0 #7a0000,0 0 18px #ffd700,0 0 42px #ff8c00;
    animation:pop 1s ease-in-out infinite alternate;
  }
  @keyframes pop{from{transform:scale(.94)}to{transform:scale(1.08)}}

  .line{
    font-family:"STKaiti","KaiTi","FangSong","SimSun",serif;
    font-size:clamp(2.5rem,12.5vw,9rem);
    line-height:.88;margin:0;letter-spacing:-.005em;
    filter:drop-shadow(0 0 26px rgba(255,215,0,.9)) drop-shadow(0 0 70px rgba(255,0,0,.85));
    animation:lineTilt 1.1s ease-in-out infinite alternate;
  }
  .line.alt{animation-duration:.86s;animation-delay:-.4s}
  @keyframes lineTilt{from{transform:rotate(-1.2deg) skewX(-1.5deg)}to{transform:rotate(1.2deg) skewX(1.5deg)}}

  .ltr{
    display:inline-block;
    background:linear-gradient(180deg,
      #fffbe6 0%, #ffd700 38%, #b8860b 72%, #fff3b0 100%);
    -webkit-background-clip:text;background-clip:text;
    -webkit-text-fill-color:transparent;
    -webkit-text-stroke:clamp(1.5px,.6vw,5px) #c40000;
    paint-order:stroke fill;
    filter:drop-shadow(0 0 6px #ffd700)
           drop-shadow(0 0 20px #ff8c00)
           drop-shadow(0 7px 0 rgba(90,0,0,.9));
    transform-origin:50% 88%;
    animation:ltrBounce .6s ease-in-out infinite alternate;
    animation-delay:calc(var(--i) * -.055s);
  }
  @keyframes ltrBounce{from{transform:translateY(0) rotate(-3deg) scale(1)}to{transform:translateY(-9%) rotate(4deg) scale(1.07)}}

  .tiger-row{font-size:clamp(1.4rem,5.6vw,3rem);letter-spacing:.08em;filter:drop-shadow(0 0 16px #ffd700)}
  .tiger-row span{display:inline-block;animation:hop .5s ease-in-out infinite alternate}
  .tiger-row span:nth-child(2n){animation-delay:.12s}
  .tiger-row span:nth-child(3n){animation-delay:.24s}
  @keyframes hop{from{transform:translateY(0) rotate(-10deg)}to{transform:translateY(-16px) rotate(12deg) scale(1.18)}}

  .blink{
    font-family:"STKaiti","KaiTi","FangSong","SimSun",serif;
    font-weight:900;font-size:clamp(.8rem,2.5vw,1.5rem);letter-spacing:.18em;
    color:#ffe600;text-shadow:3px 3px 0 #7a0000,0 0 24px #ffd700;
    animation:blink .75s steps(1) infinite;
  }
  @keyframes blink{50%{opacity:0}}

  #boom{
    margin-top:.5rem;
    font-family:Impact,"Arial Black",sans-serif;
    font-size:clamp(.9rem,2.7vw,1.6rem);letter-spacing:.1em;
    padding:.55em 1.5em;color:#fff;text-shadow:3px 3px 0 #7a0000;
    border:6px ridge #ffd700;border-radius:999px;
    background:linear-gradient(180deg,#ff0040 0%,#ff8a00 55%,#ffd700 100%);
    box-shadow:0 0 0 6px #7a0000,0 0 30px #ffd700,0 0 80px #ff0040;
    cursor:pointer;animation:pulse .5s ease-in-out infinite alternate;
    transition:transform .1s;
  }
  #boom:hover{transform:scale(1.07) rotate(-1.5deg)}
  #boom:active{transform:scale(.93) rotate(2deg)}
  @keyframes pulse{
    from{box-shadow:0 0 0 6px #7a0000,0 0 22px #ffd700,0 0 60px #ff0040}
    to{box-shadow:0 0 0 6px #7a0000,0 0 50px #ffd700,0 0 130px #ff0040}
  }

  /* ================= 装饰 ================= */
  .lantern{
    position:fixed;top:-10px;font-size:clamp(60px,10vw,120px);z-index:46;
    filter:drop-shadow(0 0 26px #ff5a00);transform-origin:top center;
    animation:swing 3s ease-in-out infinite alternate;pointer-events:none;
  }
  .lantern.l{left:4%}
  .lantern.r{right:4%;animation-delay:1.5s}
  @keyframes swing{from{transform:rotate(-9deg)}to{transform:rotate(9deg)}}

  .firecrackers{
    position:fixed;bottom:6px;left:50%;transform:translateX(-50%);z-index:46;
    font-size:clamp(1.6rem,5vw,3.4rem);letter-spacing:.2em;pointer-events:none;
    filter:drop-shadow(0 0 18px #ff0040);
    animation:hop .4s ease-in-out infinite alternate;
  }

  #frame{
    position:fixed;inset:10px;z-index:46;pointer-events:none;border:6px solid transparent;border-radius:6px;
    background:linear-gradient(#2a0000,#2a0000) padding-box,
      repeating-linear-gradient(45deg,#ffd700 0 8px,#b8860b 8px 16px) border-box;
    opacity:.8;
  }

  .seal{
    position:fixed;bottom:96px;right:16px;z-index:47;pointer-events:none;
    width:88px;height:88px;background:#c40000;color:#fff;
    font-family:"STKaiti","KaiTi","FangSong","SimSun",serif;
    display:grid;place-items:center;text-align:center;
    font-size:11px;letter-spacing:2px;line-height:1.15;
    border:3px solid #7a0000;border-radius:8px;transform:rotate(-12deg);
    box-shadow:0 0 22px rgba(196,0,0,.85);
  }

  /* ================= 画布粒子 ================= */
  #fx{position:fixed;inset:0;z-index:40;pointer-events:none}

  /* ================= 遮罩层 ================= */
  #dark{
    position:fixed;inset:0;z-index:50;pointer-events:none;
    background:radial-gradient(circle at 50% 20%, #0a0a0a 0%, #000 60%);
    transition:opacity .5s ease;
  }
  #dark.on{opacity:.98}
  #dark.off{opacity:0}

  #strobe{
    position:fixed;inset:0;z-index:48;pointer-events:none;opacity:0;
    mix-blend-mode:hard-light;animation:strobeCSS 3.4s steps(1) infinite;
  }
  @keyframes strobeCSS{
    0%,58%{opacity:0;background:transparent}
    59%{opacity:.3;background:#ff00e6}
    60%{opacity:0;background:transparent}
    79%{opacity:.24;background:#ffd700}
    80%{opacity:0;background:transparent}
    93%{opacity:.28;background:#ff0040}
    94%{opacity:0;background:transparent}
  }

  #flash{position:fixed;inset:0;z-index:80;background:#fff;opacity:0;pointer-events:none}

  /* ================= 灯泡 ================= */
  #lamp-wrap{
    position:fixed;top:0;left:50%;transform:translateX(-50%);z-index:60;
    display:flex;flex-direction:column;align-items:center;pointer-events:none;
  }
  #cord{
    width:7px;height:170px;border-radius:4px;cursor:grab;touch-action:none;pointer-events:auto;
    background:repeating-linear-gradient(180deg,#ffe066 0 6px,#b8860b 6px 12px);
    box-shadow:0 0 12px rgba(255,215,0,.7);
    transition:height .25s cubic-bezier(.34,1.56,.64,1);
  }
  #bulb{
    pointer-events:auto;cursor:grab;touch-action:none;margin-top:-2px;position:relative;
    transition:transform .25s cubic-bezier(.34,1.56,.64,1);
  }
  #cord.dragging,#bulb.dragging{transition:none}
  #bulb .glow{filter:drop-shadow(0 0 26px rgba(255,230,120,.95)) drop-shadow(0 0 70px rgba(255,170,0,.7))}
  #bulb.off .glow{filter:drop-shadow(0 0 30px rgba(255,200,80,1)) drop-shadow(0 0 90px rgba(255,140,0,.9))}
  #bulb.on .glow{filter:drop-shadow(0 0 30px rgba(255,255,255,.9)) drop-shadow(0 0 80px rgba(255,255,180,.8))}

  .hint{
    position:fixed;top:270px;left:50%;transform:translateX(-50%);z-index:60;pointer-events:none;
    font-family:"Courier New",monospace;font-weight:900;font-size:clamp(.8rem,2.4vw,1.3rem);
    color:#ffd700;text-shadow:0 0 14px #ff8c00,2px 2px 0 #000;
    animation:blink 1s steps(1) infinite;
  }

  /* ================= HUD ================= */
  #hud{position:fixed;inset:0;z-index:65;pointer-events:none}
  #sound{
    position:absolute;top:10px;left:10px;pointer-events:auto;
    font-family:"Courier New",monospace;font-weight:900;font-size:.72rem;
    padding:6px 10px;border:3px solid #7a0000;border-radius:8px;
    background:#ffd700;color:#7a0000;cursor:pointer;box-shadow:3px 3px 0 #000;
  }
  #sound:active{transform:translate(2px,2px);box-shadow:1px 1px 0 #000}

  .pull-count{
    position:absolute;top:10px;right:10px;pointer-events:none;
    font-family:"Courier New",monospace;font-weight:900;
    font-size:clamp(1rem,3.4vw,1.9rem);color:#ffd700;
    text-shadow:0 0 16px #ff8c00,3px 3px 0 #000;
    background:rgba(60,0,0,.8);padding:.25em .6em;border:3px solid #ffd700;border-radius:8px;
  }

  .ach-panel{
    position:absolute;right:10px;bottom:10px;width:min(280px,88vw);pointer-events:auto;
    background:rgba(60,0,0,.92);border:3px solid #ffd700;border-radius:10px;
    padding:8px 10px;color:#ffd700;box-shadow:0 0 30px rgba(255,0,0,.6);
    max-height:52vh;overflow:auto;
  }
  .ach-title{font-family:Impact,"Arial Black",sans-serif;font-size:1.1rem;letter-spacing:.1em;text-align:center;margin-bottom:4px;text-shadow:0 0 12px #ff8c00}
  .ach-list{list-style:none;margin:0;padding:0;font-family:"Courier New",monospace;font-size:.78rem}
  .ach{display:flex;align-items:center;gap:6px;padding:3px 4px;border-radius:6px;opacity:.55}
  .ach .ic{font-size:1rem}
  .ach .nm{flex:1}
  .ach .st{font-size:.8rem}
  .ach.unlocked{opacity:1;background:rgba(255,215,0,.18);color:#fff;text-shadow:0 0 10px #ffd700}
  .cheat-row{display:flex;gap:6px;margin-top:6px;flex-wrap:wrap}
  .cheat-row button{
    flex:1;font-family:Impact,"Arial Black",sans-serif;font-size:.75rem;letter-spacing:.05em;
    padding:5px 6px;border:3px ridge #ffd700;border-radius:8px;cursor:pointer;
    background:linear-gradient(#ff0040,#b8002a);color:#fff;text-shadow:1px 1px 0 #000;
  }
  .reset-btn{
    display:block;margin:6px auto 0;background:none;border:none;color:#ffb3b3;
    cursor:pointer;font-family:"Courier New",monospace;font-size:.65rem;text-decoration:underline;
  }

  /* ================= TOASTS ================= */
  #toasts{position:fixed;top:56px;left:50%;transform:translateX(-50%);z-index:70;pointer-events:none;display:flex;flex-direction:column;gap:6px;align-items:center}
  .toast{
    font-family:Impact,"Arial Black",sans-serif;font-size:clamp(.9rem,2.4vw,1.4rem);
    letter-spacing:.06em;padding:.45em 1em;border-radius:999px;
    background:linear-gradient(180deg,#ffe600,#ff8a00);color:#7a0000;
    border:4px solid #7a0000;box-shadow:0 0 30px #ffd700;
    animation:toastIn 3.2s cubic-bezier(.2,.8,.2,1) forwards;
  }
  @keyframes toastIn{
    0%{transform:translateY(-30px) scale(.6);opacity:0}
    10%{transform:translateY(0) scale(1.05);opacity:1}
    85%{transform:translateY(0) scale(1);opacity:1}
    100%{transform:translateY(-20px) scale(.8);opacity:0}
  }

  @media (max-width:560px){
    .seal{display:none}
    .diag.m1{top:20%}
    .diag.m2{bottom:18%}
    .hint{top:230px}
  }
  @media (prefers-reduced-motion: reduce){
    #bg,#rays,#stripes,#strobe,.spikes,.ltr,.line,.head,.marquee .track,.diag .track{animation-duration:12s !important}
    #scene{animation:none}
  }
</style>
</head>
<body>

<div id="world">
  <div id="shakebox">
    <div id="scene">
      <div id="bg"></div>
      <div id="rays"></div>
      <div id="stripes"></div>
      <div id="wm"></div>

      <div id="tigerwrap">
        <svg class="spikes s1" viewBox="0 0 200 200" aria-hidden="true">
          <defs>
            <linearGradient id="spg1" x1="0" y1="0" x2="1" y2="1">
