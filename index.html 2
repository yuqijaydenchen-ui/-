        <div class="blink">★ PULL THE LIGHT TO START ★</div>
        <button id="boom" type="button">💥 EXPLODE THE TIGERS 💥</button>
      </main>
    </div>
  </div>

  <div class="lantern l">🏮</div>
  <div class="lantern r">🏮</div>
  <div class="firecrackers">🧨🧨🧨🧨🧨🧨</div>
  <div id="frame"></div>
  <div class="seal">MR<br>BELLE<br>888</div>
</div>

<canvas id="fx"></canvas>
<div id="strobe"></div>
<div id="dark" class="on"></div>

<!-- 灯泡 -->
<div id="lamp-wrap">
  <div id="cord"></div>
  <div id="bulb" class="off" role="button" aria-label="Pull the light">
    <svg viewBox="0 0 100 120" width="100" height="120" aria-hidden="true">
      <defs>
        <radialGradient id="glass" cx="42%" cy="35%" r="65%">
          <stop offset="0%" stop-color="#fffbe6"/>
          <stop offset="55%" stop-color="#ffe066"/>
          <stop offset="100%" stop-color="#e8a800"/>
        </radialGradient>
      </defs>
      <g class="glow">
        <path d="M50 6 C78 6 92 30 92 54 C92 72 82 88 70 96 L70 104 L30 104 L30 96 C18 88 8 72 8 54 C8 30 22 6 50 6 Z"
              fill="url(#glass)" stroke="#8a6508" stroke-width="3"/>
        <path d="M40 104 L60 104 L64 114 L36 114 Z" fill="#9a9a9a" stroke="#5a5a5a" stroke-width="2"/>
        <path d="M44 46 Q50 32 56 46" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round"/>
        <path d="M40 60 Q50 50 60 60" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" opacity=".8"/>
      </g>
    </svg>
  </div>
</div>
<div class="hint" id="hint">▼ PULL THE LIGHT ▼</div>

<!-- HUD -->
<div id="hud">
  <button id="sound" type="button">🔊 SOUND OFF</button>
  <div class="pull-count">PULLS: <span id="pulls">0</span></div>
  <div class="ach-panel">
    <div class="ach-title">🏆 ACHIEVEMENTS 🏆</div>
    <ul class="ach-list" id="ach-list"></ul>
    <div class="cheat-row" id="cheat-row" style="display:none">
      <button id="cheat1m" type="button">💰 +1M PULLS</button>
      <button id="cheat1b" type="button">🤑 +1B PULLS</button>
    </div>
    <button class="reset-btn" id="reset" type="button">RESET PROGRESS</button>
  </div>
</div>

<div id="toasts"></div>
<div id="flash"></div>

<script>
(() => {
  const $ = s => document.querySelector(s);
  const rand = (a, b) => a + Math.random() * (b - a);
  const pick = a => a[(Math.random() * a.length) | 0];
  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ================= 标题字母 ================= */
  function buildLine(el, text) {
    [...text].forEach((ch, i) => {
      const s = document.createElement('span');
      s.className = 'ltr';
      s.textContent = ch === ' ' ? '\u00A0' : ch;
      s.style.setProperty('--i', i);
      el.appendChild(s);
    });
  }
  buildLine($('#line1'), 'THANK YOU');
  buildLine($('#line2'), 'MR. BELLE');

  /* ================= 水印 ================= */
  $('#wm').textContent = ('888 ★ FORTUNE ★ MR. BELLE ★ ').repeat(60);

  /* ================= 粒子引擎 ================= */
  const cvs = $('#fx'), ctx = cvs.getContext('2d');
  let W = 0, H = 0, DPR = 1;
  function resize() {
    DPR = Math.min(2, window.devicePixelRatio || 1);
    W = innerWidth; H = innerHeight;
    cvs.width = Math.round(W * DPR);
    cvs.height = Math.round(H * DPR);
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  }
  resize();
  addEventListener('resize', resize);

  const EMOJI = ['🐯','🐅','🧨','🧧','🪙','🏮','💥','⭐','✨','🔥','🐯','🐅','🪙','🧧','🐯'];
  const parts = [], rings = [];
  const MAXP = 300;

  function spawn(x, y, n, o = {}) {
    const size = o.size || [22, 90];
    const spd  = o.spd  || [2, 15];
    const life = o.life || [42, 110];
    const spread = (o.spread === undefined) ? 0.8 : o.spread;
    for (let i = 0; i < n; i++) {
      if (parts.length >= MAXP) parts.shift();
      const a = (o.dir === undefined) ? rand(0, Math.PI * 2) : o.dir + rand(-spread, spread);
      const v = rand(spd[0], spd[1]);
      const ttl = rand(life[0], life[1]);
      parts.push({
        x, y,
        vx: Math.cos(a) * v,
        vy: Math.sin(a) * v,
        size: rand(size[0], size[1]),
        rot: rand(0, 6.283), vr: rand(-.26, .26),
        ttl, max: ttl,
        g: (o.g === undefined) ? 0.05 : o.g,
        ch: o.ch || pick(EMOJI)
      });
    }
  }
  function ring(x, y, r0, vr, ttl, color, w) {
    rings.push({ x, y, r: r0, vr, ttl, max: ttl, color, w });
  }

  let prev = performance.now();
  function frame(now) {
    const dt = Math.min(60, now - prev) / 16.6667;
    prev = now;
    ctx.clearRect(0, 0, W, H);
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';

    for (let i = parts.length - 1; i >= 0; i--) {
      const p = parts[i];
      p.vy += p.g * dt;
      p.vx *= Math.pow(0.985, dt);
      p.vy *= Math.pow(0.985, dt);
      p.x += p.vx * dt;
      p.y += p.vy * dt;
      p.rot += p.vr * dt;
      p.ttl -= dt;
      if (p.ttl <= 0 || p.y > H + 160 || p.x < -160 || p.x > W + 160) {
        parts.splice(i, 1);
        continue;
      }
      const k = clamp(p.ttl / p.max, 0, 1);
      ctx.save();
      ctx.globalAlpha = Math.min(1, k * 1.9);
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rot);
      ctx.font = `${p.size}px "Apple Color Emoji","Segoe UI Emoji","Noto Color Emoji",sans-serif`;
      ctx.fillText(p.ch, 0, 0);
      ctx.restore();
    }

    for (let i = rings.length - 1; i >= 0; i--) {
      const r = rings[i];
      r.r += r.vr * dt;
      r.ttl -= dt;
      if (r.ttl <= 0) { rings.splice(i, 1); continue; }
      const k = r.ttl / r.max;
      ctx.save();
      ctx.globalAlpha = k * 0.9;
      ctx.strokeStyle = r.color;
      ctx.lineWidth = Math.max(1, r.w * k);
      ctx.beginPath();
      ctx.arc(r.x, r.y, Math.max(0, r.r), 0, 6.28318);
      ctx.stroke();
      ctx.restore();
    }
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);

  /* ================= 屏幕特效 ================= */
  const shakebox = $('#shakebox'), hero = $('#hero'), flashEl = $('#flash'), strobeEl = $('#strobe');

  function shake(power = 12, dur = 420) {
    const kf = [];
    const steps = 8;
    for (let i = 0; i <= steps; i++) {
      const p = 1 - i / steps;
      kf.push({
        transform: `translate(${(Math.random() - .5) * 2 * power * p}px,${(Math.random() - .5) * 2 * power * p}px) rotate(${(Math.random() - .5) * 1.8 * p}deg)`
      });
    }
    shakebox.animate(kf, { duration: dur, easing: 'ease-out' });
  }
  function flash(s = .9, d = 300) {
    flashEl.animate([{ opacity: 0 }, { opacity: s }, { opacity: 0 }], { duration: d, easing: 'ease-out' });
  }
  function strobeHit() {
    const colors = ['#ff00e6', '#ffd700', '#ff0040', '#ff8c00'];
    const kf = [];
    for (let i = 0; i < 6; i++) {
      kf.push({ opacity: i % 2 ? 0 : rand(.2, .5), background: pick(colors), offset: i / 6 });
    }
    kf.push({ opacity: 0 });
    strobeEl.animate(kf, { duration: rand(240, 420), easing: 'steps(1)' });
  }

  /* ================= 声音 ================= */
  let actx = null, soundOn = false;
  function ensureCtx() {
    if (!actx) actx = new (window.AudioContext || window.webkitAudioContext)();
    if (actx.state === 'suspended') actx.resume();
    return actx;
  }
  function beep(freq, dur, type = 'square', vol = .15, when = 0) {
    if (!soundOn) return;
    try {
      const c = ensureCtx();
      const t = c.currentTime + when;
      const o = c.createOscillator(), g = c.createGain();
      o.type = type; o.frequency.value = freq;
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(vol, t + 0.01);
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      o.connect(g); g.connect(c.destination);
      o.start(t); o.stop(t + dur + 0.05);
    } catch (e) { /* ignore */ }
  }
  function noiseBurst(dur = .4, vol = .25) {
    if (!soundOn) return;
    try {
      const c = ensureCtx(), sr = c.sampleRate;
      const buf = c.createBuffer(1, Math.floor(sr * dur), sr);
      const d = buf.getChannelData(0);
      for (let i = 0; i < d.length; i++) {
        const p = 1 - i / d.length;
        d[i] = (Math.random() * 2 - 1) * p * p * p;
      }
      const src = c.createBufferSource(); src.buffer = buf;
      const f = c.createBiquadFilter(); f.type = 'lowpass'; f.frequency.value = 1200;
      const g = c.createGain(); g.gain.value = vol;
      src.connect(f); f.connect(g); g.connect(c.destination);
      src.start();
    } catch (e) { /* ignore */ }
  }
  function boomSound(vol = .3) {
    if (!soundOn) return;
    try {
      noiseBurst(.5, vol);
      const c = ensureCtx();
      const osc = c.createOscillator(); osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(320, c.currentTime);
      osc.frequency.exponentialRampToValueAtTime(48, c.currentTime + 0.45);
      const g = c.createGain();
      g.gain.setValueAtTime(0.0001, c.currentTime);
      g.gain.exponentialRampToValueAtTime(vol * .5, c.currentTime + 0.03);
      g.gain.exponentialRampToValueAtTime(0.0001, c.currentTime + 0.5);
      const lp = c.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 1800;
      osc.connect(lp); lp.connect(g); g.connect(c.destination);
      osc.start(); osc.stop(c.currentTime + 0.55);
    } catch (e) { /* ignore */ }
  }

  $('#sound').addEventListener('click', () => {
    soundOn = !soundOn;
    $('#sound').textContent = soundOn ? '🔊 SOUND ON' : '🔊 SOUND OFF';
    if (soundOn) { ensureCtx(); beep(880, .12, 'square', .12); }
  });

  /* ================= 成就系统 ================= */
  const ACHS = [
    { key: '10',   n: 10,        label: '10 PULLS',    icon: '💡' },
    { key: '100',  n: 100,       label: '100 PULLS',   icon: '🔥' },
    { key: '1k',   n: 1000,      label: '1,000 PULLS', icon: '⚡' },
    { key: '10k',  n: 10000,     label: '10,000 PULLS', icon: '🌟' },
    { key: '1m',   n: 1000000,   label: '1M PULLS',    icon: '💎' },
    { key: '1b',   n: 1000000000,label: '1B PULLS',    icon: '🏆' },
    { key: 'cheater', n: Infinity, label: 'CHEATER',    icon: '🤡' },
  ];

  const LS_KEY = 'tigerBelleLampV1';
  let saved = null;
  try { saved = JSON.parse(localStorage.getItem(LS_KEY) || 'null'); } catch (e) {}
  let pulls = (saved && saved.pulls) || 0;
  const unlocked = new Set((saved && saved.unlocked) || []);
  let cheater = !!(saved && saved.cheater);

  function fmt(n) {
    if (n >= 1e9) return (n / 1e9).toFixed(2).replace(/\.?0+$/, '') + 'B';
    if (n >= 1e6) return (n / 1e6).toFixed(2).replace(/\.?0+$/, '') + 'M';
    return n.toLocaleString('en-US');
  }
  function persist() {
    try {
      localStorage.setItem(LS_KEY, JSON.stringify({ pulls, unlocked: [...unlocked], cheater }));
    } catch (e) {}
  }
  function updatePulls() {
    $('#pulls').textContent = fmt(pulls);
    $('#cheat-row').style.display = pulls >= 10 ? 'flex' : 'none';
  }
  function renderAch() {
    const ul = $('#ach-list');
    ul.innerHTML = '';
    ACHS.forEach(a => {
      const li = document.createElement('li');
      li.className = 'ach' + (unlocked.has(a.key) ? ' unlocked' : '');
      li.innerHTML = `<span class="ic">${a.icon}</span><span class="nm">${a.label}</span><span class="st">${unlocked.has(a.key) ? '✅' : '🔒'}</span>`;
      ul.appendChild(li);
    });
  }
  function toast(msg) {
    const t = document.createElement('div');
    t.className = 'toast';
    t.textContent = msg;
    $('#toasts').appendChild(t);
    setTimeout(() => t.remove(), 3300);
  }
  function unlock(key) {
    if (unlocked.has(key)) return;
    unlocked.add(key);
    const a = ACHS.find(x => x.key === key);
    if (a) {
      toast(`🏆 ACHIEVEMENT UNLOCKED: ${a.label}`);
      beep(660, .15, 'square', .14);
      setTimeout(() => beep(880, .18, 'square', .14), 140);
    }
    renderAch();
    persist();
  }
  function checkAchievements() {
    for (const a of ACHS) {
      if (a.key === 'cheater') continue;
      if (pulls >= a.n) unlock(a.key);
    }
  }

  /* ================= 大爆炸 ================= */
  function bigBoom(cx, cy) {
    cx = (cx === undefined) ? W / 2 : cx;
    cy = (cy === undefined) ? H / 2 : cy;
    spawn(cx, cy, 46, { size: [28, 140], spd: [4, 24], life: [45, 120] });
    spawn(cx, cy, 18, { size: [80, 200], spd: [2, 9], life: [55, 130] });
    ring(cx, cy, 8, 18, 42, '#ffffff', 16);
    ring(cx, cy, 4, 28, 56, '#ffd700', 9);
    ring(cx, cy, 2, 36, 48, '#ff0040', 7);
    flash(.95, 340);
    strobeHit();
    shake(28, 520);
    boomSound(.34);
  }

  /* ================= 灯泡拉绳 ================= */
  const cordEl = $('#cord'), bulbEl = $('#bulb');
  const BASE = 170, MAXPULL = 170, THRESHOLD = 36;
  let lightOn = false, dragging = false, startY = 0, pullY = 0, justPulled = false;

  function setPull(d, animate = true) {
    if (!animate) {
      cordEl.classList.add('dragging');
      bulbEl.classList.add('dragging');
    } else {
      cordEl.classList.remove('dragging');
      bulbEl.classList.remove('dragging');
    }
    pullY = clamp(d, 0, MAXPULL);
    cordEl.style.height = (BASE + pullY) + 'px';
    bulbEl.style.transform = `translateY(${pullY}px)`;
  }
  function toggleLight() {
    lightOn = !lightOn;
    $('#dark').className = 'off' + (lightOn ? '' : ' on');
    $('#dark').classList.toggle('on', !lightOn);
    $('#dark').classList.toggle('off', lightOn);
    bulbEl.classList.toggle('on', lightOn);
    bulbEl.classList.toggle('off', !lightOn);
    $('#hint').textContent = lightOn ? '▼ PULL TO TURN OFF ▼' : '▼ PULL TO TURN ON ▼';
  }
  function doPull() {
    pulls++;
    persist();
    updatePulls();
    toggleLight();
    beep(440, .08, 'square', .12);
    beep(300, .1, 'square', .1, .05);

    const r = bulbEl.getBoundingClientRect();
    const bx = r.left + r.width / 2, by = r.top + r.height / 2;

    if (lightOn) {
      flash(.55, 220);
      spawn(bx, by, 18, { size: [24, 90], spd: [3, 16] });
      ring(bx, by, 4, 16, 28, '#ffd700', 8);
      shake(12, 300);
    } else {
      // 关灯瞬间短暂白光，然后黑
      flash(.7, 160);
    }
    checkAchievements();
  }

  function down(e) {
    dragging = true; startY = e.clientY;
    justPulled = false;
    setPull(0, false);
  }
  function move(e) {
    if (!dragging) return;
    setPull(e.clientY - startY, false);
  }
  function up() {
    if (!dragging) return;
    dragging = false;
    const wasPulled = pullY > THRESHOLD;
    justPulled = wasPulled;
    setPull(0, true);
    if (wasPulled) doPull();
  }
  function clickPull() {
    if (justPulled) { justPulled = false; return; }
    doPull();
  }

  [cordEl, bulbEl].forEach(el => {
    el.addEventListener('pointerdown', down);
    el.addEventListener('pointermove', move);
    el.addEventListener('pointerup', up);
    el.addEventListener('pointercancel', up);
    el.addEventListener('click', clickPull);
  });

  /* ================= 作弊 ================= */
  function cheat(amount) {
    cheater = true;
    pulls += amount;
    unlock('cheater');
    checkAchievements();
    updatePulls();
    persist();
    toast(`🤡 CHEATER! +${fmt(amount)} PULLS`);
    beep(196, .4, 'sawtooth', .18);
    setTimeout(() => beep(156, .5, 'sawtooth', .18), 400);
    bigBoom();
  }
  $('#cheat1m').addEventListener('click', () => cheat(1000000));
  $('#cheat1b').addEventListener('click', () => cheat(1000000000));

  let typed = '';
  addEventListener('keydown', e => {
    if (e.key.toLowerCase() === 't') { bigBoom(); return; }
    typed += e.key.toLowerCase();
    if (typed.length > 12) typed = typed.slice(-12);
    if (typed.includes('cheat')) { typed = ''; cheat(1000000); }
  });

  $('#reset').addEventListener('click', () => {
    if (!confirm('RESET ALL PROGRESS?')) return;
    pulls = 0; cheater = false; unlocked.clear();
    updatePulls(); renderAch(); persist();
    toast('🔄 PROGRESS RESET');
  });

  /* ================= 按钮 ================= */
  $('#boom').addEventListener('click', e => { e.stopPropagation(); bigBoom(); });

  let lastDown = 0;
  addEventListener('pointerdown', e => {
    if (e.target.closest('#lamp-wrap') || e.target.closest('#hud')) return;
    const now = performance.now();
    if (now - lastDown < 60) return;
    lastDown = now;
    spawn(e.clientX, e.clientY, 20, { size: [26, 120], spd: [3, 18] });
    ring(e.clientX, e.clientY, 4, 20, 34, '#fff', 8);
    flash(.4, 220);
    shake(9, 260);
    boomSound(.18);
  });

  let lastMove = 0;
  addEventListener('pointermove', e => {
    const now = performance.now();
    if (now - lastMove < 42) return;
    lastMove = now;
    spawn(e.clientX, e.clientY, 1, { size: [16, 46], spd: [.5, 4], life: [26, 60], g: 0.02 });
  }, { passive: true });

  /* ================= 自动混乱 ================= */
  if (!reduce) {
    setInterval(() => {
      if (document.hidden || parts.length >= MAXP - 4) return;
      for (let i = 0; i < 2; i++) {
        const ttl = rand(70, 150);
        parts.push({
          x: rand(0, W), y: -70,
          vx: rand(-1.2, 1.2), vy: rand(3, 9),
          size: rand(18, 66), rot: rand(0, 6.283), vr: rand(-.13, .13),
          ttl, max: ttl, g: 0.02,
          ch: pick(['🐯', '🐅', '🧨', '🧧', '🪙', '💥', '⭐'])
        });
      }
    }, 130);

    setInterval(() => { if (!document.hidden) spawn(rand(.08, .92) * W, rand(.1, .9) * H, 4); }, 620);
    setInterval(() => { if (!document.hidden) shake(11, 380); }, 3400);
    setInterval(() => { if (!document.hidden) bigBoom(); }, 9000);
  } else {
    setInterval(() => { if (!document.hidden) spawn(rand(.1, .9) * W, rand(.1, .9) * H, 2); }, 1600);
  }

  /* ================= 初始化 ================= */
  updatePulls();
  renderAch();
  // 打开即黑
  $('#dark').classList.add('on');
  $('#dark').classList.remove('off');
  bulbEl.classList.add('off');
  $('#hint').textContent = '▼ PULL THE LIGHT TO START ▼';
})();
</script>
