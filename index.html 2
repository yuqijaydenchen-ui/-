          <path d="M84 152 l7 15 l8 -13 l9 15 l8 -15 l8 13 l7 -15"
                fill="#fff" stroke="#000" stroke-width="3" stroke-linejoin="round"/>
          <g stroke="#000" stroke-width="4" stroke-linecap="round">
            <path d="M62 150 L18 138"/><path d="M62 162 L18 166"/>
            <path d="M158 150 L202 138"/><path d="M158 162 L202 166"/>
          </g>
        </svg>
      </div>

      <div class="diag m1">
        <div class="track c">
          <span>🐯 MR. BELLE IS THE GOAT ★ GOLD FORTUNE 888 ★ 🧨 🐯 MR. BELLE IS THE GOAT ★ GOLD FORTUNE 888 ★ 🧨 </span>
          <span>🐯 MR. BELLE IS THE GOAT ★ GOLD FORTUNE 888 ★ 🧨 🐯 MR. BELLE IS THE GOAT ★ GOLD FORTUNE 888 ★ 🧨 </span>
        </div>
      </div>
      <div class="diag m2">
        <div class="track d">
          <span>★ BEST VIEWED AT 800x600 ★ NO REFUNDS ★ 100% FREE TIGERS ★ PULL THE LIGHT ★ </span>
          <span>★ BEST VIEWED AT 800x600 ★ NO REFUNDS ★ 100% FREE TIGERS ★ PULL THE LIGHT ★ </span>
        </div>
      </div>

      <main id="hero">
        <div class="kicker">✨ WELCOME ★ GOLD FORTUNE ★ 888 ✨</div>
        <h1 class="line" id="line1"></h1>
        <h1 class="line alt" id="line2"></h1>
        <div class="tiger-row">
          <span>🐯</span><span>🧨</span><span>🧧</span><span>🐅</span><span>🪙</span><span>💥</span><span>🐯</span><span>🧧</span><span>🐅</span>
