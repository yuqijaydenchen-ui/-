          </g>
          <ellipse cx="80" cy="104" rx="20" ry="22" fill="#fff" stroke="#000" stroke-width="5"/>
          <ellipse cx="140" cy="104" rx="20" ry="22" fill="#fff" stroke="#000" stroke-width="5"/>
          <circle cx="80" cy="107" r="9" fill="#000"/>
          <circle cx="140" cy="107" r="9" fill="#000"/>
          <circle cx="84" cy="101" r="3.2" fill="#fff"/>
          <circle cx="144" cy="101" r="3.2" fill="#fff"/>
